{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/v2/(.*)",
      "destination": "/backend/main.py"
    },
    {
      "source": "/auth/google/callback(.*)",
      "destination": "/backend/main.py"
    },
    {
      "source": "/((?!css|js|data|api|backend|frontend|.*\\..*).*)",
      "destination": "/frontend/index.html"
    }
  ]
}
